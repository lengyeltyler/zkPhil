# zkPhil Sepolia configuration template.
# Copy this file to `.env` and fill in your own values.
# Never commit real private keys, mnemonics, RPC credentials, or signer keys.

# Runtime mode for the backend server.
NODE_ENV=production

# Sepolia JSON-RPC endpoint used by deploy scripts, verification, and the backend.
RPC_URL_SEPOLIA=https://sepolia.infura.io/v3/your_project_id

# Default RPC_URL fallback used by older scripts.
RPC_URL=${RPC_URL_SEPOLIA}

# Local development RPC used by local user-op and backend simulation flows.
RPC_URL_LOCAL=http://127.0.0.1:8545

# Expected chain id for Sepolia.
CHAIN_ID=11155111

# Deployer wallet private key for Sepolia broadcasts.
PRIVATE_KEY=0xyour_private_key_here

# Cairo program hash used by ProofGateTest13.
PROGRAM_HASH=0x4444444444444444444444444444444444444444444444444444444444444444

# Phil test drop id.
DROP_ID=13

# Optional explicit allowlist signer address.
# If omitted, deploy_stark.mjs uses the deployer address unless you set ALLOWLIST_SIGNER_KEY in backend runtime.
ALLOWLIST_SIGNER=0xyour_allowlist_signer_address

# Backend signer private key for mint proof issuance.
ALLOWLIST_SIGNER_KEY=0xyour_allowlist_signer_private_key

# Backend signer private key for paymaster sponsorship signing.
PAYMASTER_SIGNER_KEY=0xyour_paymaster_signer_private_key

# Optional explicit addresses for the existing art backend.
# Leave blank to read from deployments/sepolia-addresses.json on Sepolia.
PHIL_SVG_STORAGE=
PHIL_LAYER_REGISTRY=

# Deployment-time Starknet bindings required for the live 4337 unlock flow.
STARKNET_CORE=0xyour_starknet_core_address
L2_UNLOCK_VERIFIER=0xyour_l2_unlock_verifier_felt

# Optional paymaster deposit amount in ETH for deploy_4337.mjs.
PAYMASTER_DEPOSIT=0.001

# Backend bind address and port.
HOST=127.0.0.1
PORT=8787

# SQLite path for the backend allowlist/proof state.
DATABASE_PATH=./server-ts/data/zkphil.sepolia.db

# CORS allowlist for the backend.
CORS_ORIGINS=

# Safety toggles for non-loopback binding and browser origins.
UNSAFE_NONLOOPBACK_OK=false
ALLOW_LOOPBACK_ORIGINS=false

# Mint request TTL for backend-issued proofs, in seconds.
MINT_TTL_SECONDS=600

# Allowlist mode for the backend.
ALLOWLIST_MODE=single_address
ALLOWLIST_SINGLE_ADDRESS=0xyour_allowlisted_wallet
ALLOWLIST_SLOTS_PER_DROP=1
UNSAFE_DEV_ALLOWLIST=false

# Optional deployed-address overrides consumed by the backend after Sepolia deployment.
PROOF_GATE=
PHIL_TEST_MINT=
PHIL_ACCOUNT_FACTORY=
PHIL_PAYMASTER=

# Optional frontend read-only/public RPC override for Vite builds.
VITE_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional WalletConnect project id for wallet connection UI.
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional Etherscan key if you wire verification into your workflow.
ETHERSCAN_API_KEY=your_etherscan_api_key_here
