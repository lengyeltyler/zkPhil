# zkPhil local-proving / Sepolia configuration template.
# Copy to `.env` and fill in the values you actually use.
# Never commit real private keys, RPC credentials, or operator keys.

NODE_ENV=production

# Network
CHAIN_ID=11155111
RPC_URL_SEPOLIA=https://sepolia.infura.io/v3/your_project_id
RPC_URL=${RPC_URL_SEPOLIA}
RPC_URL_LOCAL=http://127.0.0.1:8545

# Deployer / paymaster
PRIVATE_KEY=0xyour_private_key_here
PAYMASTER_SIGNER_KEY=0xyour_paymaster_signer_private_key

# Identity gate / Cairo program
PROGRAM_HASH=0x4444444444444444444444444444444444444444444444444444444444444444
PROOF_CONTEXT=13
HUMANITY_PROVIDER=local-credential

# Generic bundle path used by the selected humanity provider.
HUMANITY_BUNDLE_PATH=

# Credential bundle used by the backend in HUMANITY_PROVIDER=local-credential mode.
CREDENTIAL_BUNDLE_PATH=./generated/proofs/credential-bundle.json

# DEV/TEST ONLY. Mock-humanity bundle used when HUMANITY_PROVIDER=mock.
MOCK_HUMANITY_BUNDLE_PATH=./generated/proofs/mock-humanity-bundle.json

# Optional art-backend reuse mode:
#   reuse-stable        -> reuse config/stable-art-backends/<network>.json
#   reuse-existing-data -> reuse deployments/art_<chainId>.json when healthy
#   deploy-local        -> re-bootstrap local art/data contracts
ART_BACKEND_MODE=
ART_BACKEND_MANIFEST_PATH=

# Optional override for helper scripts that need a Node 22 runtime.
NODE_BIN=

# Fact registry bridge
# Sepolia SHARP fact registry:
# FACT_REGISTRY=0x07ec0D28e50322Eb0C159B9090ecF3aeA8346DFe
FACT_REGISTRY=

# Local dev only. Used by POST /register-proof on chainId 31337.
FACT_REGISTRY_OPERATOR_KEY=

# Optional deployed-address overrides consumed by the backend.
PROOF_GATE=
PHIL_IDENTITY_MINT=
PHIL_ACCOUNT_FACTORY=
PHIL_PAYMASTER=

# 4337 unlock path
STARKNET_CORE=0xyour_starknet_core_address
L2_UNLOCK_VERIFIER=0xyour_l2_unlock_verifier_felt
PAYMASTER_DEPOSIT=0.001

# Backend
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./server-ts/data/zkphil.sepolia.db
CORS_ORIGINS=
UNSAFE_NONLOOPBACK_OK=false
ALLOW_LOOPBACK_ORIGINS=false
MINT_TTL_SECONDS=600

# Local prover service used by the browser/client
LOCAL_PROVER_HOST=127.0.0.1
LOCAL_PROVER_PORT=8747
LOCAL_PROVER_MANIFEST=./cairo/Scarb.toml
LOCAL_PROVER_ENABLE_PROVE=true
LOCAL_PROVER_ENABLE_VERIFY=false

# Frontend
VITE_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional Etherscan key
ETHERSCAN_API_KEY=your_etherscan_api_key_here
