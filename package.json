{
  "name": "zkphil",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "compile": "node scripts/local/compileContracts.mjs",
    "fragments:build": "node scripts/fragments/build.mjs",
    "fragments:deploy": "node scripts/fragments/deploy.mjs",
    "render:verify": "node scripts/render-verify.mjs",
    "sepolia:nonce": "node scripts/sepolia/nonce.mjs",
    "sepolia:runall": "node scripts/sepolia/run_all_and_mint_one.mjs",
    "sepolia:smoke": "node scripts/sepolia/smoke.mjs",
    "verify:sepolia": "node scripts/verify_sepolia_bindings.mjs",
    "test": "npm run compile && npm run test:legacy && npm run test:art-backend && npm run test:node && npm run test:hardhat && npm run test:server",
    "test:art-backend": "node scripts/run-tests.mjs",
    "test:node": "npx hardhat compile && node --test test/svg-render.integration.test.mjs test/allowlist-proof.contract.test.mjs test/frontend-selection.integration.test.mjs test/error-cases.contract.test.mjs test/paymaster-sponsorship.test.mjs test/unlock-ticket-2fa.test.mjs test/proof-parity.action.test.mjs test/backend-compatibility.test.mjs test/frontend-connectivity.test.mjs test/verify-sepolia-bindings.test.mjs",
    "test:hardhat": "npx hardhat test test/proofgate.backend-signer.test.js test/phil-account.auto-approval.test.js test/phil-marketplace.test.js",
    "test:server": "cd server-ts && npm test",
    "test:legacy": "node scripts/check_no_legacy_rails.mjs",
    "test:svg": "node --test test/svg-render.integration.test.mjs",
    "test:proof": "node --test test/allowlist-proof.contract.test.mjs",
    "test:proof-parity": "node --test test/proof-parity.action.test.mjs",
    "test:errors": "node --test test/error-cases.contract.test.mjs",
    "render:all": "node scripts/render_all_phils.mjs",
    "frontend:dev": "vite --config frontend-local/vite.config.mjs",
    "renderer:report": "node scripts/local/renderer-footprint-report.mjs",
    "test:e2e:local": "node scripts/simulate_userop.mjs",
    "node": "hardhat node",
    "local:simulate-userop": "node scripts/simulate_userop.mjs",
    "proofs:verify-fact": "node scripts/proofs/verify_fact_registered.mjs",
    "dev:local": "bash scripts/dev.sh",
    "frontend:build": "vite build --config frontend-local/vite.config.mjs",
    "sharp:build": "bash sharpAccountV1/build.sh",
    "sharp:prove": "bash sharpAccountV1/prove.sh --sample",
    "sharp:deploy": "node sharpAccountV1/deploy.mjs",
    "sharp:e2e": "node sharpAccountV1/e2e.mjs",
    "sharp:test": "node --test sharpAccountV1/test/sharpAccount.2fa.test.mjs",
    "audit": "node --test test/svg-storage.test.mjs test/layer-registry.test.mjs test/phil-nft.test.mjs test/svg-render.integration.test.mjs test/error-cases.contract.test.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.4",
    "dotenv": "16.6.1",
    "hardhat": "2.28.4",
    "svgo": "4.0.0",
    "vite": "7.3.1"
  },
  "dependencies": {
    "ethers": "6.16.0",
    "ganache": "7.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "solady": "0.0.281",
    "starknet": "9.2.1"
  }
}
